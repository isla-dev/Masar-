# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Public origin this API is reachable at — used to build absolute URLs for
# uploaded files. Defaults to http://localhost:$PORT; only change this if
# you're running the API behind a different host/port/proxy.
API_BASE_URL=http://localhost:5000

# Database
DATABASE_URL=postgres://lms_user:lms_password@localhost:5432/lms_db

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=200

# Payments — Chargily Pay (processes CIB and EDAHABIA cards in DZD via SATIM
# and Algerie Poste). Get your keys from https://pay.chargily.com (test mode
# dashboard: https://pay.chargily.com/test/dashboard/developers-corner).
# The same key is used both for API calls and for verifying webhook signatures.
PAYMENT_PROVIDER=chargily
CHARGILY_API_KEY=
CHARGILY_MODE=test
